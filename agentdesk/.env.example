# Choose model backend: openai or ollama.
LLM_PROVIDER=openai
# Paste your OpenAI API key here (https://platform.openai.com/api-keys).
OPENAI_API_KEY=your_openai_api_key_here
# Model name for the selected provider (OpenAI example: gpt-4o-mini, Ollama example: llama3.1).
MODEL_NAME=gpt-4o-mini
# Optional for Ollama users: local Ollama server URL (default install value).
OLLAMA_BASE_URL=http://localhost:11434
# Optional Tavily key for web search tool (https://app.tavily.com/).
TAVILY_API_KEY=
# Console log level (INFO recommended for normal runs).
LOG_LEVEL=INFO
# Relative path to rotating debug log file.
LOG_FILE=logs/agentdesk.log
# Relative path for file tool sandbox directory.
WORKSPACE_DIR=workspace
# Agent loop guard: max tool-call iterations per user turn.
MAX_ITERATIONS=8
# LLM temperature (0.0 is most deterministic).
TEMPERATURE=0.0
